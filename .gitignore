# Ignore everything in home by default
/*

# Explicit root files to keep
!/README.md
!/.gitignore
!/.gitconfig
!/.zshrc
!/.zprofile
!/.p10k.zsh
!/.tmux.conf
!/.wezterm.lua

# Only allow selected .config directories
!/.config/
/.config/*

!/.config/aerospace/
!/.config/aerospace/**
!/.config/git/
!/.config/git/**
!/.config/karabiner/
!/.config/karabiner/**
!/.config/linearmouse/
!/.config/linearmouse/**
!/.config/neofetch/
!/.config/neofetch/**
!/.config/nvim/
!/.config/nvim/**
!/.config/yadm/
!/.config/yadm/**

# Only allow .local/bin
!/.local/
/.local/*
!/.local/bin/
!/.local/bin/**

# Ignore generated files
.DS_Store
/.config/karabiner/automatic_backups/
/.config/nvim/lazy-lock.json
/.config/nvim/nvim.log
